# Keep the build context small and never copy secrets / local-only material.
.git
.gitignore
node_modules
vendor
build
dist
public/build
public/hot
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
.env
.env.*
!.env.example
CREDS
.predeploy.log
*.log

# Local Dude-import working data - customer databases + exports live here during testing and
# must NEVER end up in a published image (they can contain device credentials). Ship only the
# extraction script itself.
scripts/*.db
scripts/export
scripts/__pycache__

# Not needed inside the web image
agent
tests
deploy/build/vendor
docs
context
PRD.md
database/SCHEMA.md
