# My Mate remote agent configuration (systemd EnvironmentFile).
# Installed to /etc/mymate-agent/agent.env - keep it root-readable only (contains a token).

# The central app's URL. http(s):// is rewritten to ws(s):// and /agent is appended.
MYMATE_URL=https://mymate.example.com

# The agent's bearer token, from:  php artisan mymate:agent:create "Site name"
MYMATE_AGENT_TOKEN=mma_replace_me

# Optional: a label reported to the server (defaults to the hostname).
#MYMATE_AGENT_NAME=Site A

# Optional: info (default) or debug.
#MYMATE_AGENT_LOG=info

# Optional: set to 1 only to skip TLS verification against a self-signed dev server.
#MYMATE_AGENT_INSECURE=0
