# My Mate - HTTPS site (nginx terminates TLS). Rendered by `mymate-ssl` for the
# Let's Encrypt (method 3) and own-certificate (method 4) paths, then installed to
# /etc/nginx/sites-available/mymate. Placeholders __SERVER_NAME__ / __SSL_CERT__ /
# __SSL_KEY__ are substituted at render time.
#
# For a Cloudflare Tunnel (method 1) or an upstream reverse proxy (method 2), TLS is
# terminated elsewhere - keep the plain :80 site (nginx-mymate.conf) and let the app
# detect https from X-Forwarded-Proto (trusted proxies). See README.md.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Redirect all plain HTTP to HTTPS (leave ACME challenges reachable for renewals).
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SERVER_NAME__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:MyMateTLS:10m;
    ssl_session_timeout 1d;

    root /opt/mymate/public;
    index index.php;
    charset utf-8;

    # >= the php pool's upload_max_filesize/post_max_size and mymate.import.max_upload_kb
    # (a Dude database can be hundreds of MB).
    client_max_body_size 1024m;

    # Reverb WebSocket - the browser connects to wss://<host>/app on the same origin.
    location /app {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    # Remote-agent WebSocket hub - probes connect to wss://<host>/agent (Bearer token).
    location /agent {
        proxy_pass http://127.0.0.1:9091;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTPS on;          # tell PHP/Laravel the request is secure
        fastcgi_pass unix:/run/php/php8.4-fpm-mymate.sock;
        fastcgi_index index.php;
    }

    location /build/ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    error_log  /var/log/nginx/mymate.error.log;
    access_log /var/log/nginx/mymate.access.log;
}
