APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Authentication.
# Set these to the EXACT host the SPA is served from (no scheme for stateful domains).
# In production that's your real FQDN - e.g.:
#   APP_URL=https://mymate.example.net.au
#   SANCTUM_STATEFUL_DOMAINS=mymate.example.net.au
#   CORS_ALLOWED_ORIGINS=https://mymate.example.net.au
#   REVERB_ALLOWED_ORIGINS=mymate.example.net.au
#   SESSION_SECURE_COOKIE=true            # required over HTTPS
# If the served host isn't listed here, the session cookie is ignored and /api returns 401.
# The localhost entries below are only for local dev (php artisan serve / vite).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1
CORS_ALLOWED_ORIGINS="${APP_URL}"
REVERB_ALLOWED_ORIGINS=*
# false is only safe for local http://localhost dev. Any deployment reachable over
# HTTPS MUST set this true (see README -> Production deployment -> Auth host).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Reverb (WebSocket server driving the live map colour ramp) ---
# Required whenever BROADCAST_CONNECTION=reverb. Generate your own app id/key/secret
# per deployment (any unique strings); the VITE_REVERB_* mirrors are read by the SPA.
REVERB_APP_ID=mymate-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- My Mate engine ---
# Device secrets the seeder reads (copy real values from the git-ignored CREDS file):
MYMATE_DEVICE_USER=
MYMATE_DEVICE_PASS=
MYMATE_SNMP_COMMUNITY=
# Engine log (pollers/discovery/loop) -> storage/logs/mymate.log. Set LEVEL=debug for per-tick heartbeats.
MYMATE_LOG_LEVEL=info
MYMATE_LOG_CHANNEL=mymate
MYMATE_LOG_DAYS=14
# Scale-out / cadence (full set in config/mymate.php):
MYMATE_POLL_SHARDS=16
# Auto-discovery: scan cadence + blast-radius/lockout safety caps.
MYMATE_DISCOVERY_CHECK_INTERVAL=30
MYMATE_DISCOVERY_SCAN_INTERVAL=3600
MYMATE_DISCOVERY_MAX_HOSTS=4096
MYMATE_DISCOVERY_ATTEMPT_DELAY_MS=200
# Recent history: partitioned interface_samples + retention.
MYMATE_HISTORY_ENABLED=true
MYMATE_HISTORY_RETENTION_DAYS=14
MYMATE_HISTORY_MAX_POINTS=240

# --- Config backups: the external Rusted engine ---
# Rusted (github.com/JoshFinlayAU/rusted) is a localhost Go sidecar that captures device
# configs over SSH and versions them in git; My Mate is its control plane / API client.
# These are just defaults - the live URL/token/SSH fallback are set in-app (Settings ->
# Config backup engine) and stored encrypted. See deploy/rusted/README.md to stand up
# the sidecar. Bind Rusted to loopback; the token must match its config.toml.
RUSTED_API_URL=http://127.0.0.1:8410
RUSTED_API_TOKEN=
# RUSTED_API_TIMEOUT=120
# RUSTED_SSH_PORT=22
