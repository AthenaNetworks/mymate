# My Mate - instance configuration. Generated on install; edit and then run
#   sudo systemctl restart mymate-* && sudo -u mymate php /opt/mymate/artisan config:clear
# after changes. Secrets (APP_KEY, DB_PASSWORD, REVERB_APP_SECRET) are filled in
# automatically by the installer.

APP_NAME="My Mate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (local PostgreSQL, provisioned by the installer) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mymate
DB_USERNAME=mymate
DB_PASSWORD=

# --- Redis (queues, cache, sessions, Horizon) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=reverb

# --- Authentication (Sanctum SPA cookie auth) ---
# Set to the EXACT host(s) the console is browsed from (the installer detects the
# server's hostname + IP). If you reach it by another name, add it here (or run
# `php artisan mymate:configure-host <host>`), else /api returns 401.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1
CORS_ALLOWED_ORIGINS=*
# Set true once you serve over HTTPS (certbot --nginx), else leave false for http.
SESSION_SECURE_COOKIE=false

# --- Reverb (WebSocket server driving the live map colour ramp) ---
# REVERB_APP_KEY is the PUBLIC client key baked into the SPA build - keep it "mymate".
# REVERB_APP_SECRET is generated per install and stays server-side (private-channel auth).
REVERB_APP_ID=
REVERB_APP_KEY=mymate
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*

# --- Mail (optional; also configurable in Settings -> Mail server) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerts@mymate.local"
MAIL_FROM_NAME="${APP_NAME}"
