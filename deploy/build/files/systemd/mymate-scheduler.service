[Unit]
Description=My Mate - scheduler (history-partition retention + maintenance)
After=network.target postgresql.service redis-server.service
# Never give up restarting. With the default start limit (5 starts in 10s) a fast crash
# loop, eg the DB not up yet, leaves the unit failed until someone notices (see #48).
StartLimitIntervalSec=0

[Service]
Type=simple
User=mymate
Group=mymate
WorkingDirectory=/opt/mymate
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/php /opt/mymate/artisan schedule:work
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
