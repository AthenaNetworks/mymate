[Unit]
Description=My Mate - remote-agent WebSocket hub (probes connect here)
After=network.target postgresql.service redis-server.service
Requires=redis-server.service
# Never give up restarting. With the default start limit (5 starts in 10s) a fast crash
# loop, eg the DB not up yet, leaves the unit failed until someone notices (see #48).
StartLimitIntervalSec=0

[Service]
Type=simple
User=mymate
Group=mymate
WorkingDirectory=/opt/mymate
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# nginx reverse-proxies the /agent location on the public port to this local hub.
ExecStart=/usr/bin/php /opt/mymate/artisan mymate:agent-hub --host=127.0.0.1 --port=9091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
